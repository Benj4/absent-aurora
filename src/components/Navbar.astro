</style>

<script>
  import type { Session } from "@supabase/auth-js";
  import { supabase } from "../lib/supabase";

  // Toggle dropdown menu
  const profileButton = document.getElementById("profileButton");
  const dropdownMenu = document.getElementById("dropdownMenu");
  const logoutBtn = document.getElementById("logoutBtn");

  const loginLink = document.getElementById("login-link");
  const loginButton = document.getElementById("login-button");
  const profileMenu = document.getElementById("profile-menu");
  const userEmail = document.getElementById("user-email");

  // Check auth state on load
  async function checkAuthState(session: Session | null) {
    let user = session?.user;

    if (!user) {
      user = (await supabase.auth.getUser())?.data?.user ?? undefined;
    }

    if (user) {
      // User is logged in - show profile menu
      if (loginLink) loginLink.style.display = "none";
      if (loginButton) loginButton.style.display = "none";
      if (profileMenu) profileMenu.style.display = "block";
      if (userEmail) userEmail.textContent = user.email || "";

      document.getElementById("own-posts-link")?.setAttribute("href", `/user/${user.id}/post`);

    } else {
      // User is not logged in - show login button
      if (loginLink) loginLink.style.display = "block";
      if (loginButton) loginButton.style.display = "block";
      if (profileMenu) profileMenu.style.display = "none";
    }
  }

  // Toggle dropdown menu
  if (profileButton && dropdownMenu) {
    profileButton.addEventListener("click", () => {
      dropdownMenu.classList.toggle("active");
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (!profileButton.contains(target) && !dropdownMenu.contains(target)) {
        dropdownMenu.classList.remove("active");
      }
    });
  }

  // Logout functionality
  if (logoutBtn) {
    logoutBtn.addEventListener("click", async () => {
      try {
        await supabase.auth.signOut();
        window.location.href = "/login";
      } catch (error) {
        console.error("Logout error:", error);
      }
    });
  }

  // Listen for auth state changes
  supabase.auth.onAuthStateChange((event, session) => {
    // console.log("Auth state changed:", { event, session });
    checkAuthState(session);
  });

  // Initial auth check
  // checkAuthState(null);
</script>
