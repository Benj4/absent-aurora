  }

  .dropdown-divider {
    margin: 0.25rem 0;
    border: none;
    border-top: 1px solid #e5e7eb;
  }

  .login-button {
    padding: 0.5rem 1rem;
    background-color: #3b82f6;
    color: white;
    text-decoration: none;
    border-radius: 0.375rem;
    font-weight: 500;
    font-size: 0.875rem;
    transition: background-color 0.2s;
  }

  .login-button:hover {
    background-color: #2563eb;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .navbar-links {
      gap: 1rem;
    }

