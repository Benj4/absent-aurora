---
import LoginForm from './LoginForm';
---

<div id="login-page">
  <LoginForm client:load />
</div>

<script is:inline>
  // Preserve the recovery marker before the shared auth client consumes the URL hash.
  document.getElementById('login-page').dataset.recovery =
    String(new URLSearchParams(window.location.hash.slice(1)).get('type') === 'recovery');
</script>
