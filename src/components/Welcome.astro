---
// Auth component for Sign In and Sign Up
---

<div id="auth-container">
	<main>
		<section id="auth-section">
			<h1>Authentication</h1>
			
			<!-- Sign In Form -->
			<div class="box auth-box">
				<h2>Sign In</h2>
				<form id="signin-form" class="auth-form">
					<label>
						<span class="label-text">Email</span>
						<input name="email" type="email" required />
					</label>
					<label>
						<span class="label-text">Password</span>
						<input name="password" type="password" minlength="6" required />
					</label>
					<div class="form-actions">
						<button type="submit" class="button">Sign In</button>
						<span id="signin-status" class="status-text"></span>
					</div>
				</form>
			</div>

			<!-- Sign Up Form -->
			<div class="box auth-box">
				<h2>Sign Up</h2>
				<form id="signup-form" class="auth-form">
					<label>
						<span class="label-text">Email</span>
						<input name="email" type="email" required />
					</label>
					<label>
						<span class="label-text">Password</span>
						<input name="password" type="password" minlength="6" required />
					</label>
					<div class="form-actions">
						<button type="submit" class="button">Sign Up</button>
						<span id="signup-status" class="status-text"></span>
					</div>
				</form>
			</div>
		</section>
	</main>
</div>

<script>
	import { supabase } from '../lib/supabase';

	// Sign In Form Handler
	const signinForm = document.getElementById("signin-form") as HTMLFormElement;
	const signinStatus = document.getElementById("signin-status") as HTMLSpanElement;
	
	signinForm?.addEventListener("submit", async (e) => {
		e.preventDefault();
		signinStatus.textContent = "Signing in…";
		signinStatus.className = "status-text";
		
		const formData = new FormData(signinForm);
		const email = formData.get("email") as string;
		const password = formData.get("password") as string;
		
		try {
			const { data, error } = await supabase.auth.signInWithPassword({
				email,
				password,
			});
			
			if (error) throw error;
			
			signinStatus.textContent = "✓ Signed in successfully!";
			signinStatus.className = "status-text success";
			
			// Redirect or update UI as needed
			setTimeout(() => {
				window.location.href = `${import.meta.env.BASE_URL}`;
			}, 1000);
		} catch (err: any) {
			signinStatus.textContent = `✗ ${err.message ?? "Sign in failed"}`;
			signinStatus.className = "status-text error";
		}
	});

	// Sign Up Form Handler
	const signupForm = document.getElementById("signup-form") as HTMLFormElement;
	const signupStatus = document.getElementById("signup-status") as HTMLSpanElement;
	
	signupForm?.addEventListener("submit", async (e) => {
		e.preventDefault();
		signupStatus.textContent = "Signing up…";
		signupStatus.className = "status-text";
		
		const formData = new FormData(signupForm);
		const email = formData.get("email") as string;
		const password = formData.get("password") as string;
		
		try {
			const { data, error } = await supabase.auth.signUp({
				email,
				password,
			});
			
			if (error) throw error;
			
			signupStatus.textContent = "✓ Check your email to confirm your account";
			signupStatus.className = "status-text success";
			signupForm.reset();
		} catch (err: any) {
			signupStatus.textContent = `✗ ${err.message ?? "Sign up failed"}`;
			signupStatus.className = "status-text error";
		}
	});

</script>

<style>
	#auth-container {
		font-family:
			Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
			sans-serif;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 16px;
	}

	main {
		width: 100%;
		max-width: 900px;
	}

	#auth-section {
		display: flex;
		flex-direction: column;
		gap: 24px;
		align-items: center;
	}

	#auth-section > h1 {
		font-size: 32px;
		font-weight: 600;
		margin: 0 0 16px 0;
		color: #111827;
	}

	.auth-box {
		width: 100%;
		max-width: 400px;
	}

	.box {
		padding: 24px;
		background: rgba(255, 255, 255, 1);
		border-radius: 16px;
		border: 1px solid #e5e7eb;
		box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
	}

	.box h2 {
		margin: 0 0 20px;
		font-weight: 600;
		color: #111827;
		font-size: 20px;
	}

	.auth-form {
		display: flex;
		gap: 16px;
		flex-direction: column;
	}

	.auth-form label {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.label-text {
		display: block;
		font-size: 14px;
		font-weight: 500;
		color: #374151;
	}

	.auth-form input {
		width: 100%;
		padding: 10px 12px;
		border: 1px solid #d1d5db;
		border-radius: 8px;
		font-size: 14px;
		transition: border-color 0.2s;
		box-sizing: border-box;
	}

	.auth-form input:focus {
		outline: none;
		border-color: #3245ff;
		box-shadow: 0 0 0 3px rgba(50, 69, 255, 0.1);
	}

	.form-actions {
		display: flex;
		gap: 12px;
		align-items: center;
		flex-wrap: wrap;
	}

	.button {
		padding: 10px 20px;
		color: white;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		border-radius: 8px;
		border: none;
		font-size: 14px;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s;
	}

	.button:hover {
		background: linear-gradient(83.21deg, #2838e6 0%, #a83fd4 100%);
		box-shadow: none;
	}

	.button:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.status-text {
		font-size: 14px;
		color: #6b7280;
	}

	.status-text.success {
		color: #059669;
	}

	.status-text.error {
		color: #dc2626;
	}

	@media screen and (min-width: 768px) {
		#auth-section {
			flex-direction: row;
			align-items: stretch;
			gap: 32px;
		}

		#auth-section > h1 {
			width: 100%;
			text-align: center;
		}
	}
</style>
