---
// filepath: src/components/PostCard.astro
interface SerieData {
  id: number;
  date: string;
  value: number;
}

interface Post {
  id: number;
  indicator_id: string;
  data_source?: string;
  frequency: string;
  status: string;
  created_at: string;
  updated_at?: string;
  serie_data?: SerieData[];
}

interface Props {
  post: Post;
  maxDataPoints?: number;
  showLinks?: boolean;
}

const { post, maxDataPoints = 10, showLinks = true } = Astro.props;
---

<div class="border border-foreground/20 rounded-lg p-4 bg-foreground/5">
  <div class="flex justify-between items-start mb-3">
    <h2 class="text-xl font-bold mb-0">Post #{post.id}</h2>
    <span class={`px-3 py-1 rounded-full text-sm font-semibold ${
      post.status === 'approved' 
        ? 'bg-green-200 text-green-800' 
        : post.status === 'pending' 
        ? 'bg-yellow-200 text-yellow-800' 
        : post.status === 'rejected'
        ? 'bg-red-200 text-red-800'
        : 'bg-gray-200 text-gray-800'
    }`}>
      {post.status}
    </span>
  </div>
  
  <div class="grid grid-cols-2 gap-3 text-sm mb-4">
    <div><strong>Indicator:</strong> {post.indicator_id}</div>
    <div><strong>Frequency:</strong> {post.frequency}</div>
    <div><strong>Data Source:</strong> {post.data_source || 'N/A'}</div>
    <div><strong>Created:</strong> {new Date(post.created_at).toLocaleDateString()} at {new Date(post.created_at).toLocaleTimeString()}</div>
    {post.updated_at && (
      <div class="col-span-2"><strong>Updated:</strong> {new Date(post.updated_at).toLocaleDateString()} at {new Date(post.updated_at).toLocaleTimeString()}</div>
    )}
  </div>
  
  {post.serie_data && post.serie_data.length > 0 ? (
    <div class="mt-4">
      <h3 class="text-lg font-semibold mb-2">Series Data ({post.serie_data.length} points)</h3>
      <div class="overflow-x-auto">
        <table class="min-w-full border border-gray-300">
          <thead class="bg-gray-100 dark:bg-gray-700">
            <tr>
              <th class="border border-gray-300 px-4 py-2 text-left">Date</th>
              <th class="border border-gray-300 px-4 py-2 text-right">Value</th>
            </tr>
          </thead>
          <tbody>
            {post.serie_data
              .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
              .slice(0, maxDataPoints)
              .map((data) => (
                <tr>
                  <td class="border border-gray-300 px-4 py-2">{data.date}</td>
                  <td class="border border-gray-300 px-4 py-2 text-right">{data.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        {post.serie_data.length > maxDataPoints && (
          <p class="text-sm text-gray-600 mt-2 italic">Showing {maxDataPoints} most recent of {post.serie_data.length} data points</p>
        )}
      </div>
    </div>
  ) : (
    <div class="bg-gray-100 dark:bg-gray-700 rounded p-3 mt-3">
      <p class="text-gray-600 m-0">No series data attached to this post.</p>
    </div>
  )}
  
  {showLinks && (
    <div class="flex gap-3 mt-4">
      <a href={`/post?id=${post.id}`} class="text-blue-600 hover:text-blue-800 text-sm font-semibold">Review and validate</a>
      {/* <a href={`/edit/${post.indicator_id}`} class="text-purple-600 hover:text-purple-800 text-sm font-semibold">Edit Indicator</a> */}
      {/* <a href={`/indicators/${post.indicator_id}/data`} class="text-green-600 hover:text-green-800 text-sm font-semibold">View All Data</a> */}
    </div>
  )}
</div>
