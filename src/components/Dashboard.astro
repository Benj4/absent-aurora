---
import indicatorsData from '../data/indicators.json';
import IndicatorCard from './IndicatorCard';
const { sections = [], indicators = [] } = indicatorsData || {};


export interface Indicator {
  id: string
}

const indicatorMap: Map<string, Indicator> = new Map(indicators.map((i) => [i.id, i]));

---

<div class="dashboard">

  {sections.map(section => (
    <section class="my-8 pb-6 border-b border-base-300">
      <div class="flex items-center gap-3">
        <span class="w-1.5 h-6 bg-primary rounded"></span>
        <div class="text-2xl md:text-3xl font-extrabold tracking-tight mb-3 text-base-content leading-tight">{section.title}</div>
      </div>
      {section.groups?.map(group => (
        <div class="group">
          <div class="font-semibold my-4 text-base-content">{group.title}</div>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-3 bentogrid">
            {group.indicatorIds?.map(indId => {
              const ind = indicatorMap.get(indId);
              if (!ind) return (
                <div class="card border border-base-300 bg-base-100 p-4 shadow-sm" data-bento="1x1">
                  <div class="font-semibold">{indId}</div>
                  <div class="text-base-content/60 mt-2">Indicador no definido en el catálogo</div>
                </div>
              );

              return <IndicatorCard client:visible ind={ind} />
            })}
          </div>
        </div>
      ))}
    </section>
  ))}
</div>
