---
// import '../assets/style.css';
import indicatorsData from '../data/indicators.json';
import IndicatorCard from './IndicatorCard';
const { sections = [], indicators = [] } = indicatorsData || {};


export interface Indicator {
  id: string
}

// const indicatorMap = new Map(indicators.map(i => [i.id, i]));
const indicatorMap: Map<string, Indicator> = new Map(indicators.map((i) => [i.id, i]));

---

<div class="dashboard">

  {sections.map(section => (
    <section class="my-8 pb-6 border-b border-slate-200 dark:border-slate-700">
      <div class="flex items-center gap-3">
        <span class="w-1.5 h-6 bg-(--color-700) rounded"></span>
        <div class="text-2xl md:text-3xl font-extrabold tracking-tight mb-3 text-(--color-700) leading-tight">{section.title}</div>
      </div>
      {section.groups?.map(group => (
        <div class="group">
          <div class="font-semibold my-4 text-(--color-700)">{group.title}</div>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-3 bentogrid" id="dashboard-bento">
            {group.indicatorIds?.map(indId => {
              const ind = indicatorMap.get(indId);
              if (!ind) return (
                <div class="relative overflow-hidden transform-gpu will-change-transform border border-[rgba(0,0,0,0.06)] p-4 rounded-xl bg-linear-to-b from-[rgba(255,255,255,0.9)] to-(--astro-card-bg,#fff) shadow-[0_12px_30px_rgba(2,6,23,0.08),0_6px_12px_rgba(2,6,23,0.04)] hover:-translate-y-1 hover:scale-[1.01] transition-transform duration-200 ease-out hover:shadow-[0_18px_40px_rgba(2,6,23,0.12),0_8px_16px_rgba(2,6,23,0.06)] hover:ring-1 hover:ring-[rgba(70,95,255,0.08)]" data-bento="1x1">
                  <div class="font-semibold">{indId}</div>
                  <div class="text-[#888] mt-2">Indicator not defined in catalog</div>
                </div>
              );

              return <IndicatorCard client:visible ind={ind} />
            })}
          </div>
        </div>
      ))}
    </section>
  ))}
</div>

<script type="module">
