---
// filepath: src/pages/edit/[id].astro
import Layout from '../../layouts/Layout.astro';
import indicatorsData from '../../data/indicators.json';

export function getStaticPaths() {
  const { indicators = [] } = indicatorsData;
  return indicators.map((indicator) => ({
    params: { id: indicator.id },
    props: { indicator },
  }));
}

const { indicator } = Astro.props;
---

<Layout>
  <main class="prose" style="padding:1.25rem">
    <h1>Edit Indicator: {indicator.label}</h1>
    <p>Editing indicator ID: <strong>{indicator.id}</strong></p>

    <div class="flex justify-center">
      <form id="edit-form" class="mx-auto text-left max-w-150">
      <div class="mb-4">
        <label for="label" class="block mb-2 font-semibold">Label:</label>
        <input class="w-full" type="text" id="label" name="label" value={indicator.label} required />
      </div>

      <div class="mb-4">
        <label for="slug" class="block mb-2 font-semibold">Slug:</label>
        <input class="w-full" type="text" id="slug" name="slug" value={indicator.slug} required />
      </div>

      <div class="mb-4">
        <label for="unit-type" class="block mb-2 font-semibold">Unit Type:</label>
        <input class="w-full" type="text" id="unit-type" name="unit-type" value={indicator.unit?.type || ''} />
      </div>

      <div class="mb-4">
        <label for="unit-symbol" class="block mb-2 font-semibold">Unit Symbol:</label>
        <input class="w-full" type="text" id="unit-symbol" name="unit-symbol" value={indicator.unit?.symbol || ''} />
      </div>

      <div class="mb-4">
        <label for="unit-notes" class="block mb-2 font-semibold">Unit Notes:</label>
        <textarea class="w-full" id="unit-notes" name="unit-notes" rows="4">{indicator.unit?.notes || ''}</textarea>
      </div>

      <div class="mb-4">
        <label for="native-frequency" class="block mb-2 font-semibold">Native Frequency:</label>
        <input class="w-full" type="text" id="native-frequency" name="native-frequency" value={indicator.nativeFrequency} />
      </div>

      <div class="mb-4">
        <label for="series" class="block mb-2 font-semibold">Series (JSON):</label>
        <textarea class="w-full" id="series" name="series" rows="10">{JSON.stringify(indicator.series || [], null, 2)}</textarea>
      </div>

      <div class="mt-2">
        <button type="submit">Save Changes (Client-Side Only)</button>
      </div>
    </form>
    </div>

    <script is:inline define:vars={{ indicator }}>
      document.getElementById('edit-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        console.log('formData :>> ', formData);
        const updatedIndicator = {
          ...indicator,
          label: formData.get('label'),
          slug: formData.get('slug'),
          unit: {
            ...indicator.unit,
            type: formData.get('unit-type'),
            symbol: formData.get('unit-symbol'),
            notes: formData.get('unit-notes'),
          },
          nativeFrequency: formData.get('native-frequency'),
          series: JSON.parse(formData.get('series') || '[]'),
        };
        console.log('Updated Indicator:', updatedIndicator);
        alert('Changes logged to console (not saved to file).');
      });
    </script>
  </main>
</Layout>