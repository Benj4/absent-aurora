---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import AnalysisViewer from '../../components/AnalysisViewer';

export async function getStaticPaths() {
  const { data, error } = await supabase
    .from('analysis')
    .select('id, title');

  if (error) {
    console.error('Error loading analysis IDs for static paths:', error);
    return [];
  }

  return (data ?? []).map((analysis: { id: string; title: string }) => ({
    params: { id: analysis.id },
    props: { title: analysis.title },
  }));
}

const { id } = Astro.params;
const { title } = Astro.props;
---

<Layout
  title={`${title} — Absent Aurora`}
  breadcrumbItems={[
    { label: 'Inicio', href: '/' },
    { label: 'Análisis', href: '/analisis' },
    { label: title },
  ]}
>
  <AnalysisViewer client:load analysisId={id!} />
</Layout>
