---
import Layout from "../../layouts/Layout.astro";
import UserAnalyses from "../../components/user/UserAnalyses";
import { withBase } from "../../lib/paths";
---

<Layout
  title="Mis análisis"
  breadcrumbItems={[
    { label: "Inicio", href: withBase("/") },
    { label: "Usuario" },
    { label: "Análisis" },
  ]}
>
  <main class="mx-auto w-full max-w-6xl px-4 py-6 md:py-8">
    <section class="bg-base-100">
      <div class="card-body gap-4 md:gap-5">
        <header class="space-y-2">
          <h1 class="text-2xl font-semibold leading-tight text-pretty">
            Mis análisis
          </h1>
          <p class="text-sm text-base-content/70">
            Aquí puedes ver todos los análisis que creaste.
          </p>
        </header>
        <UserAnalyses client:load />
        <noscript>
          <div class="alert alert-info mt-2">
            <span>
              Esta página requiere JavaScript para mostrar la lista de análisis.
            </span>
          </div>
        </noscript>
      </div>
    </section>
  </main>
</Layout>
