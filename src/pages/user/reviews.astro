---
// filepath: src/pages/user/reviews.astro
import Layout from '../../layouts/Layout.astro';
import UserReviews from '../../components/user/UserReviews';

---

<Layout>
  <main class="prose max-w-6xl mx-auto" style="padding:1.25rem">
    <div class="mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-800 text-sm">&larr; Volver al tablero</a>
    </div>

    <UserReviews client:load />

    <noscript>
      <div class="mt-4 text-gray-600">Esta página requiere JavaScript para mostrar las validaciones.</div>
    </noscript>
  </main>
</Layout>
