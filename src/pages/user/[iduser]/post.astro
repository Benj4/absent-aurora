---
// filepath: src/pages/user/[iduser]/post.astro
import Layout from '../../../layouts/Layout.astro';
import { supabase } from '../../../lib/supabase';
import PostCard from '../../../components/PostCard.astro';

// TODO: mejorable, filtrar distinct users en la query
export async function getStaticPaths() {
  // Fetch all unique submitted_by user IDs from serie_posts
  const { data: allPosts } = await supabase
    .from('serie_posts')
    .select('submitted_by');
  
  const uniqueUserIds = [...new Set(allPosts?.map(p => p.submitted_by).filter(Boolean) || [])];
  
  return uniqueUserIds.map((userId) => ({
    params: { iduser: userId }
  }));
}

const { iduser } = Astro.params;

// Fetch all posts for this user with their data
const { data: posts, error } = await supabase
  .from('serie_posts')
  .select(`
    id, indicator_id, data_source, frequency, status, created_at, updated_at,
    serie_data(id, date, value)
  `)
  .eq('submitted_by', iduser)
  .order('created_at', { ascending: false });

if (error) {
  console.error('Error fetching posts:', error);
}
---

<Layout>
  <main class="prose max-w-6xl mx-auto" style="padding:1.25rem">
    <div class="mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-800 text-sm">&larr; Back to Dashboard</a>
    </div>

    <h1>Series Posts - User {iduser}</h1>
    
    {error && (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        Error loading posts: {error.message}
      </div>
    )}
    
    {posts && posts.length === 0 && (
      <p class="text-gray-500">No posts found for this user.</p>
    )}
    
    {posts && posts.length > 0 && (
      <div class="space-y-6">
        <div class="mb-4">
          <p class="text-gray-600">Total posts: <strong>{posts.length}</strong></p>
        </div>
        
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}
  </main>
</Layout>
