---
// filepath: src/pages/user/[...slug].astro
import Layout from "../../layouts/Layout.astro";
import UserPosts from "../../components/user/UserPosts";
import { withBase } from "../../lib/paths";
---

<Layout
  breadcrumbItems={[
    { label: "Inicio", href: withBase("/") },
    { label: "Usuario" },
    { label: "Post" },
  ]}
>
  <section class="mx-auto w-full max-w-6xl space-y-6 px-4 py-6 md:py-8">
    <h1 class="text-2xl font-semibold">Publicaciones del usuario</h1>
    <UserPosts client:load />

    <noscript>
      <div class="mt-4 text-base-content/70">
        Esta página requiere JavaScript para navegar entre las secciones de
        usuario (Publicaciones, Editar, Validaciones).
      </div>
    </noscript>
  </section>
</Layout>
