---
import Layout from '../../../layouts/Layout.astro';
import AntdProvider from '../../../components/AntdProvider';
import SeriesForm from '../../../components/SeriesForm';
import indicatorsData from '../../../data/indicators.json';
import { normalizeFrequency } from '../../../lib/frequency';

interface Props {
  indicator: {
    id: string;
    label: string;
    nativeFrequency: string;
    unit?: { symbol?: string; type?: string };
  };
}

export function getStaticPaths() {
  const { indicators = [] } = indicatorsData as any;
  return indicators.map((indicator: any) => ({
    params: {
      frequency: normalizeFrequency(indicator.nativeFrequency ?? ''),
      id: indicator.id,
    },
    props: { indicator },
  }));
}

const { indicator } = Astro.props;
---

<Layout>
  <main class="prose" style="padding:1.25rem">
    <h1>Agregar Datos de Series: {indicator.label}</h1>
    <p>ID del Indicador: <strong>{indicator.id}</strong> | Frecuencia: <strong>{indicator.nativeFrequency}</strong></p>

    <AntdProvider client:load>
      <SeriesForm client:load indicator={indicator} />
    </AntdProvider>
  </main>
</Layout>
