---
// filepath: src/pages/series/monthly/[id].astro
import Layout from '../../../layouts/Layout.astro';
import indicatorsData from '../../../data/indicators.json';

export function getStaticPaths() {
  const { indicators = [] } = indicatorsData;
  return indicators
    .filter(indicator => indicator.nativeFrequency?.toLowerCase().includes('monthly'))
    .map((indicator) => ({
      params: { id: indicator.id },
      props: { indicator },
    }));
}

const { indicator } = Astro.props;
---

<Layout>
  <main class="prose" style="padding:1.25rem">
    <h1>Add Monthly Series Data: {indicator.label}</h1>
    <p>Indicator ID: <strong>{indicator.id}</strong> | Frequency: <strong>{indicator.nativeFrequency}</strong></p>

    <div class="flex justify-center">
      <form id="series-form" class="mx-auto text-left max-w-150">
        <div class="mb-4">
          <label for="date" class="block mb-2 font-semibold">Date:</label>
          <input class="w-full" type="date" id="date" name="date" required />
        </div>

        <div class="mb-4">
          <label for="data-source" class="block mb-2 font-semibold">Data Source:</label>
          <input class="w-full" type="text" id="data-source" name="data-source" placeholder="e.g., Banco Central, INE" required />
        </div>

        <div class="mb-4">
          <label for="year" class="block mb-2 font-semibold">Year:</label>
          <input class="w-full" type="number" id="year" name="year" min="1900" max="2100" placeholder="e.g., 2025" required />
        </div>

        <div class="mb-4">
          <label class="block mb-2 font-semibold">Monthly Values:</label>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-foreground/5">
                  <th class="border border-foreground/30 p-2 text-left">Month</th>
                  <th class="border border-foreground/30 p-2 text-left">Value</th>
                </tr>
              </thead>
              <tbody>
                {['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'].map((month, idx) => (
                  <tr>
                    <td class="border border-foreground/30 p-2">{month}</td>
                    <td class="border border-foreground/30 p-2">
                      <div class="flex items-center gap-2">
                        <input 
                          class="flex-1 bg-transparent border-0 p-1" 
                          type="number" 
                          step="any" 
                          name={`month-${idx + 1}`} 
                          placeholder="0.00" 
                        />
                        <span class="text-sm text-foreground/60">{indicator.unit?.symbol || indicator.unit?.type || ''}</span>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-6">
          <button type="submit">Submit Monthly Data (Client-Side Only)</button>
        </div>
      </form>
    </div>

    <script is:inline define:vars={{ indicator }}>
      const form = document.getElementById('series-form');
      
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const year = formData.get('year');
        const monthlyValues = [];
        
        for (let i = 1; i <= 12; i++) {
          const value = formData.get(`month-${i}`);
          if (value && value.trim() !== '') {
            monthlyValues.push({
              year: parseInt(year),
              month: i,
              value: parseFloat(value)
            });
          }
        }
        
        const seriesData = {
          indicatorId: indicator.id,
          date: formData.get('date'),
          dataSource: formData.get('data-source'),
          frequency: 'monthly',
          data: monthlyValues
        };
        
        console.log('Monthly Series Data Submitted:', seriesData);
        alert('Monthly data logged to console (not saved to file).');
      });
    </script>
  </main>
</Layout>
