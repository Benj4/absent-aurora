---
// filepath: src/pages/series/annual/[id].astro
import Layout from '../../../layouts/Layout.astro';
import indicatorsData from '../../../data/indicators.json';

export function getStaticPaths() {
  const { indicators = [] } = indicatorsData;
  return indicators
    .filter(indicator => !indicator.nativeFrequency?.toLowerCase().includes('monthly'))
    .map((indicator) => ({
      params: { id: indicator.id },
      props: { indicator },
    }));
}

const { indicator } = Astro.props;
---

<Layout>
  <main class="prose" style="padding:1.25rem">
    <h1>Add Annual Series Data: {indicator.label}</h1>
    <p>Indicator ID: <strong>{indicator.id}</strong> | Frequency: <strong>{indicator.nativeFrequency}</strong></p>

    <div class="flex justify-center">
      <form id="series-form" class="mx-auto text-left max-w-150">
        <div class="mb-4">
          <label for="date" class="block mb-2 font-semibold">Date:</label>
          <input class="w-full" type="date" id="date" name="date" required />
        </div>

        <div class="mb-4">
          <label for="data-source" class="block mb-2 font-semibold">Data Source:</label>
          <input class="w-full" type="text" id="data-source" name="data-source" placeholder="e.g., Banco Central, INE" required />
        </div>

        <div class="mb-4">
          <label class="block mb-2 font-semibold">Annual Values (minimum 4 rows):</label>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-foreground/5">
                  <th class="border border-foreground/30 p-2 text-left">Year</th>
                  <th class="border border-foreground/30 p-2 text-left">Value</th>
                </tr>
              </thead>
              <tbody id="annual-rows">
                {[0, 1, 2, 3].map((idx) => (
                  <tr>
                    <td class="border border-foreground/30 p-2">
                      <input 
                        class="w-full bg-transparent border-0 p-1" 
                        type="number" 
                        name={`year-${idx}`} 
                        min="0" 
                        max="9999" 
                        placeholder="e.g., 2025" 
                      />
                    </td>
                    <td class="border border-foreground/30 p-2">
                      <div class="flex items-center gap-2">
                        <input 
                          class="flex-1 bg-transparent border-0 p-1" 
                          type="number" 
                          step="any" 
                          name={`value-${idx}`} 
                          placeholder="0.00" 
                        />
                        <span class="text-sm text-foreground/60">{indicator.unit?.symbol || indicator.unit?.type || ''}</span>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <button type="button" id="add-row" class="mt-2 text-sm">+ Add Row</button>
        </div>

        <div class="mt-6">
          <button type="submit" id="submit-btn">Submit Annual Data</button>
          <p id="status-message" class="mt-2 text-sm"></p>
        </div>
      </form>
    </div>

    <script>
      import { supabase } from '../../../lib/supabase';

      // Check current session on load
      (async () => {
        const { data: { user }, error } = await supabase.auth.getUser();
        console.log('Current session:', { user, error });
      })();

      const indicator = (window as any).indicatorData;
      const form = document.getElementById('series-form') as HTMLFormElement;
      const addRowBtn = document.getElementById('add-row');
      const annualRows = document.getElementById('annual-rows');
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const statusMessage = document.getElementById('status-message') as HTMLParagraphElement;
      
      let rowCount = 4;
      
      // Add row functionality
      const unitSymbol = indicator.unit?.symbol || indicator.unit?.type || '';
      addRowBtn?.addEventListener('click', () => {
        const newRow = document.createElement('tr');
        newRow.innerHTML = `
          <td class="border border-foreground/30 p-2">
            <input 
              class="w-full bg-transparent border-0 p-1" 
              type="number" 
              name="year-${rowCount}" 
              min="0" 
              max="9999" 
              placeholder="e.g., 2025" 
            />
          </td>
          <td class="border border-foreground/30 p-2">
            <div class="flex items-center gap-2">
              <input 
                class="flex-1 bg-transparent border-0 p-1" 
                type="number" 
                step="any" 
                name="value-${rowCount}" 
                placeholder="0.00" 
              />
              <span class="text-sm text-foreground/60">${unitSymbol}</span>
            </div>
          </td>
        `;
        annualRows?.appendChild(newRow);
        rowCount++;
      });
      
      // Form submission with Supabase integration
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Disable submit button during submission
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';
        statusMessage.textContent = '';
        statusMessage.className = 'mt-2 text-sm';
        
        try {
          // Get authenticated user from the same supabase client
          const { data: { user }, error: userError } = await supabase.auth.getUser();
          
          if (userError || !user) {
            throw new Error('You must be logged in to submit data. Please login first.');
          }
          
          const formData = new FormData(e.target as HTMLFormElement);
          const yearlyValues = [];
          let idx = 0;
          
          // Collect all year-value pairs
          while (formData.has(`year-${idx}`)) {
            const year = formData.get(`year-${idx}`) as string;
            const value = formData.get(`value-${idx}`) as string;
            
            if (year && year.trim() !== '' && value && value.trim() !== '') {
              yearlyValues.push({
                year: parseInt(year),
                value: parseFloat(value)
              });
            }
            idx++;
          }
          
          // Validate minimum number of rows
          if (yearlyValues.length < 1) {
            throw new Error('Please provide at least 1 data points.');
          }
          
          const dataSource = formData.get('data-source') as string;
          const date = formData.get('date') as string;
          
          if (!dataSource || !date) {
            throw new Error('Please fill in all required fields.');
          }
          
          console.log('isert :>> ', {
              indicator_id: indicator.id,
              // submitted_by: user.id,
              data_source: dataSource,
              frequency: indicator.nativeFrequency,
              status: 'pending'
            });

          // Step 1: Insert serie_posts record with authenticated user
          const { data: postData, error: postError } = await supabase
            .from('serie_posts')
            .insert({
              indicator_id: indicator.id,
              // submitted_by: user.id,
              data_source: dataSource,
              frequency: indicator.nativeFrequency,
              status: 'pending'
            })
            .select()
            .single();
          
          if (postError) throw postError;
          
          // Step 2: Insert serie_data records
          const dataPoints = yearlyValues.map(item => ({
            post_id: postData.id,
            date: `${item.year}-01-01`, // Store as YYYY-01-01 for annual data
            value: item.value
          }));
          
          const { error: dataError } = await supabase
            .from('serie_data')
            .insert(dataPoints);
          
          if (dataError) throw dataError;
          
          // Success
          statusMessage.textContent = `✓ Successfully submitted ${yearlyValues.length} data points!`;
          statusMessage.className = 'mt-2 text-sm text-green-600';
          
          // Reset form
          form.reset();
          
        } catch (error: any) {
          console.error('Submission error:', error);
          statusMessage.textContent = `✗ Error: ${error.message || 'Failed to submit data'}`;
          statusMessage.className = 'mt-2 text-sm text-red-600';
        } finally {
          // Re-enable submit button
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Annual Data';
        }
      });
    </script>
    
    <script is:inline define:vars={{ indicator }}>
      // Make indicator data available globally for the module script
      window.indicatorData = indicator;
    </script>
  </main>
</Layout>
