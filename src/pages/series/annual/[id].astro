---
// filepath: src/pages/series/annual/[id].astro
import Layout from '../../../layouts/Layout.astro';
import SeriesAnnualForm from '../../../components/SeriesAnnualForm';
import indicatorsData from '../../../data/indicators.json';

export function getStaticPaths() {
  const { indicators = [] } = indicatorsData;
  return indicators
    .filter(indicator => !indicator.nativeFrequency?.toLowerCase().includes('monthly'))
    .map((indicator) => ({
      params: { id: indicator.id },
      props: { indicator },
    }));
}

const { indicator } = Astro.props;
---

<Layout>
  <main class="prose" style="padding:1.25rem">
    <h1>Agregar Datos de Series Anuales: {indicator.label}</h1>
    <p>ID del Indicador: <strong>{indicator.id}</strong> | Frecuencia: <strong>{indicator.nativeFrequency}</strong></p>

    <SeriesAnnualForm client:load indicator={indicator} />
  </main>
</Layout>
