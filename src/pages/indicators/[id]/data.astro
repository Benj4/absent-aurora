---
// filepath: src/pages/indicators/[id]/data.astro
import Layout from '../../../layouts/Layout.astro';
import { supabase } from '../../../lib/supabase';
import indicatorsData from '../../../data/indicators.json';
import ApprovedSeriesSelector from '../../../components/ApprovedSeriesSelector';
import IndicatorPostsClient from '../../../components/IndicatorPostsClient';
import { normalizeFrequency } from '../../../lib/frequency';
import { withBase } from '../../../lib/paths';

export const prerender = true;

export async function getStaticPaths() {
  const { indicators = [] } = indicatorsData || {};
  return indicators.map((indicator: any) => ({
    params: { id: indicator.id }
  }));
}

const { id } = Astro.params;

// Get indicator info from JSON
const { indicators = [] } = indicatorsData || {};
const indicator = indicators.find((ind: any) => ind.id === id);

// Fetch all posts for this indicator with their data
const { data: posts, error } = await supabase
  .from('serie_posts')
  .select(`
    id, indicator_id, data_source, url, frequency, status, created_at, updated_at,
    serie_data(id, date, value)
  `)
  .eq('indicator_id', id)
  .order('created_at', { ascending: false });

if (error) {
  console.error('Error fetching posts:', error);
}

// Fetch approved datapoints for the indicator (view)
const { data: approvedSeries = [], error: approvedError } = await supabase
  .from('approved_series_view')
  .select('date, value')
  .eq('indicator_id', id)
  .order('date', { ascending: true });

if (approvedError) {
  console.error('Error fetching approved series:', approvedError);
}
---

<Layout
  title={`Serie | ${indicator ? indicator.label : id}`}
  breadcrumbItems={[
    { label: 'Inicio', href: withBase('/') },
    { label: 'Indicadores' },
    { label: indicator ? indicator.label : id },
  ]}
>
  <section class="mx-auto w-full max-w-6xl px-4 py-6 md:py-8">
    <div class="card border border-base-200 bg-base-100 shadow-sm">
      <div class="card-body gap-5 md:gap-6">
        <header class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
          <div class="space-y-2">
            <h1 class="text-2xl font-semibold leading-tight">Serie: {indicator ? indicator.label : id}</h1>
            <p class="text-sm text-base-content/70">Consulta los datos aprobados y el historial de publicaciones de este indicador.</p>
          </div>
          <a
            href={withBase(`/series/${normalizeFrequency(indicator?.nativeFrequency ?? '')}/${id}`)}
            class="btn btn-primary btn-sm"
          >
            + Añadir datos
          </a>
        </header>

        {indicator && (
          <div class="grid gap-3 rounded-box bg-base-200/60 p-3 text-sm md:grid-cols-2">
            <p><span class="font-medium">ID:</span> {indicator.id}</p>
            <p><span class="font-medium">Frecuencia:</span> {indicator.nativeFrequency}</p>
            <p><span class="font-medium">Unidad:</span> {indicator.unit?.symbol || indicator.unit?.type || 'N/A'}</p>
            <p><span class="font-medium">Tipo de gráfico:</span> {indicator.preferredChart?.type || 'N/A'}</p>
          </div>
        )}

        {error && (
          <div role="alert" class="alert alert-error">
            <span>Error cargando publicaciones: {error.message}</span>
          </div>
        )}

        {approvedSeries && approvedSeries.length > 0 ? (
          <ApprovedSeriesSelector
            client:visible
            series={approvedSeries}
            label={indicator ? indicator.label : id}
          />
        ) : (
          <div role="alert" class="alert alert-warning">
            <span>No hay datos aprobados para graficar esta serie.</span>
          </div>
        )}

        <div class="stats stats-vertical border border-base-200 bg-base-100 md:stats-horizontal">
          <div class="stat px-4 py-3">
            <div class="stat-title">Publicaciones</div>
            <div class="stat-value text-2xl">{posts?.length ?? 0}</div>
            <div class="stat-desc">Total para este indicador</div>
          </div>
        </div>

        {posts && posts.length > 0 ? (
          <IndicatorPostsClient client:load posts={posts} />
        ) : (
          <div role="alert" class="alert">
            <span>No hay publicaciones registradas para este indicador.</span>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
