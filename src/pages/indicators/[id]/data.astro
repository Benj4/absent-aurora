---
// filepath: src/pages/indicators/[id]/data.astro
import Layout from '../../../layouts/Layout.astro';
import { supabase } from '../../../lib/supabase';
import indicatorsData from '../../../data/indicators.json';
import ApprovedSeriesSelector from '../../../components/ApprovedSeriesSelector';
import IndicatorPostsClient from '../../../components/IndicatorPostsClient';
import { normalizeFrequency } from '../../../lib/frequency';

export const prerender = true;

export async function getStaticPaths() {
  const { indicators = [] } = indicatorsData || {};
  return indicators.map((indicator: any) => ({
    params: { id: indicator.id }
  }));
}

const { id } = Astro.params;

// Get indicator info from JSON
const { indicators = [] } = indicatorsData || {};
const indicator = indicators.find((ind: any) => ind.id === id);

// Fetch all posts for this indicator with their data
const { data: posts, error } = await supabase
  .from('serie_posts')
  .select(`
    id, indicator_id, data_source, frequency, status, created_at, updated_at,
    serie_data(id, date, value)
  `)
  .eq('indicator_id', id)
  .order('created_at', { ascending: false });

if (error) {
  console.error('Error fetching posts:', error);
}

// Fetch approved datapoints for the indicator (view)
const { data: approvedSeries = [], error: approvedError } = await supabase
  .from('approved_series_view')
  .select('date, value')
  .eq('indicator_id', id)
  .order('date', { ascending: true });

if (approvedError) {
  console.error('Error fetching approved series:', approvedError);
}
---

<Layout>
  <main class="prose max-w-6xl mx-auto" style="padding:1.25rem">
    <div class="mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-800 text-sm">&larr; Volver al Home</a>
    </div>

    <h1>Serie: {indicator ? indicator.label : id}</h1>
    
    {indicator && (
      <div class="bg-slate-100 dark:bg-slate-800 rounded-lg p-4 mb-6">
        <div class="grid grid-cols-2 gap-3 text-sm">
          <div><strong>ID:</strong> {indicator.id}</div>
          <div><strong>Frecuencia:</strong> {indicator.nativeFrequency}</div>
          <div><strong>Unidad:</strong> {indicator.unit?.symbol || indicator.unit?.type}</div>
          <div><strong>Tipo de gráfico:</strong> {indicator.preferredChart?.type}</div>
        </div>
      </div>
    )}

    {approvedSeries && approvedSeries.length > 0 ? (
      <div class="mb-6">
        <ApprovedSeriesSelector
          client:visible
          series={approvedSeries}
          label={indicator ? indicator.label : id}
        />
      </div>
    ) : (
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded mb-4">
        <p class="m-0">No hay datos aprobados para graficar esta serie.</p>
      </div>
    )}

    {error && (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        Error cargando publicaciones: {error.message}
      </div>
    )}
    
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded mb-4">
        <p class="m-0 mt-2">
          <a 
            href={`/series/${normalizeFrequency(indicator?.nativeFrequency ?? '')}/${id}`}
            class="text-blue-600 hover:text-blue-800 font-semibold"
          >
            + Añadir datos
          </a>
        </p>
      </div>
    
    {posts && posts.length > 0 && (
      <div>
        <div class="mb-4">
          <p class="text-gray-600">Publicaciones totales: <strong>{posts.length}</strong></p>
        </div>

        <IndicatorPostsClient client:load posts={posts} />
      </div>
    )}
  </main>
</Layout>
