---
// filepath: src/pages/indicators/[id]/data.astro
import Layout from '../../../layouts/Layout.astro';
import { supabase } from '../../../lib/supabase';
import indicatorsData from '../../../data/indicators.json';
import PostCard from '../../../components/PostCard.astro';

export async function getStaticPaths() {
  const { indicators = [] } = indicatorsData || {};
  return indicators.map((indicator: any) => ({
    params: { id: indicator.id }
  }));
}

const { id } = Astro.params;

// Get indicator info from JSON
const { indicators = [] } = indicatorsData || {};
const indicator = indicators.find((ind: any) => ind.id === id);

// Fetch all posts for this indicator with their data
const { data: posts, error } = await supabase
  .from('serie_posts')
  .select(`
    id, indicator_id, data_source, frequency, status, created_at, updated_at,
    serie_data(id, date, value)
  `)
  .eq('indicator_id', id)
  .order('created_at', { ascending: false });

if (error) {
  console.error('Error fetching posts:', error);
}
---

<Layout>
  <main class="prose max-w-6xl mx-auto" style="padding:1.25rem">
    <div class="mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-800 text-sm">&larr; Back to Dashboard</a>
    </div>

    <h1>Data Posts for {indicator ? indicator.label : id}</h1>
    
    {indicator && (
      <div class="bg-slate-100 dark:bg-slate-800 rounded-lg p-4 mb-6">
        <div class="grid grid-cols-2 gap-3 text-sm">
          <div><strong>Indicator ID:</strong> {indicator.id}</div>
          <div><strong>Frequency:</strong> {indicator.nativeFrequency}</div>
          <div><strong>Unit:</strong> {indicator.unit?.symbol || indicator.unit?.type}</div>
          <div><strong>Chart Type:</strong> {indicator.preferredChart?.type}</div>
        </div>
      </div>
    )}
    
    {error && (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
        Error loading posts: {error.message}
      </div>
    )}
    
    {posts && posts.length === 0 && (
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded mb-4">
        <p class="m-0">No data posts found for this indicator.</p>
        <p class="m-0 mt-2">
          <a 
            href={indicator?.nativeFrequency?.toLowerCase().includes('monthly') ? `/series/monthly/${id}` : `/series/annual/${id}`}
            class="text-blue-600 hover:text-blue-800 font-semibold"
          >
            + Add Series Data
          </a>
        </p>
      </div>
    )}
    
    {posts && posts.length > 0 && (
      <div class="space-y-6">
        <div class="mb-4">
          <p class="text-gray-600">Total posts: <strong>{posts.length}</strong></p>
        </div>
        
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}
  </main>
</Layout>
