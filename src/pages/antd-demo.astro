---
/**
 * Página de demostración de Ant Design en Absent Aurora
 * 
 * Esta página muestra:
 * - Integración correcta de Ant Design con Astro SSR
 * - Uso de client:only para componentes React
 * - AntdProvider envolviendo todos los componentes
 * - Ejemplos de componentes comunes de Ant Design
 */
import Layout from '../layouts/Layout.astro';
import AntdProvider from '../components/AntdProvider';
import AntdExample from '../components/AntdExample';
import { withBase } from '../lib/paths';

const pageTitle = 'Demostración de Ant Design';
---

<Layout title={pageTitle}>
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4 text-[--theme-heading1]">
        {pageTitle}
      </h1>
      <p class="text-lg text-(--theme-foreground) opacity-80">
        Ejemplos de integración de Ant Design con Astro SSR y localización española
      </p>
    </div>

    <div class="mb-6 p-4 bg-blue-500/10 border border-blue-500/20 rounded-lg">
      <h2 class="text-xl font-semibold mb-2 text-blue-400">📘 Información de Implementación</h2>
      <ul class="list-disc list-inside space-y-1 text-sm">
        <li><code class="bg-black/20 px-2 py-0.5 rounded">AntdProvider</code> envuelve todos los componentes React</li>
        <li>Usa <code class="bg-black/20 px-2 py-0.5 rounded">client:only="react"</code> para componentes React puros</li>
        <li>Configuración de tema personalizado con colores de Tailwind</li>
        <li>Localización española (<code class="bg-black/20 px-2 py-0.5 rounded">esES</code>) aplicada globalmente</li>
        <li><code class="bg-black/20 px-2 py-0.5 rounded">StyleProvider</code> maneja estilos SSR correctamente</li>
      </ul>
    </div>

    <!-- Ant Design Provider wrapping the example component -->
    <AntdProvider client:load>
      <AntdExample client:load />
    </AntdProvider>

    <div class="mt-8 p-4 bg-green-500/10 border border-green-500/20 rounded-lg">
      <h2 class="text-xl font-semibold mb-2 text-green-400">✅ Uso en otros componentes</h2>
      <pre class="bg-black/30 p-4 rounded overflow-x-auto text-sm"><code>{`---
import AntdProvider from '../components/AntdProvider';
import MiComponente from '../components/MiComponente.tsx';
---

<AntdProvider client:load>
  <MiComponente />
</AntdProvider>`}</code></pre>
    </div>

    <div class="mt-8 p-4 bg-yellow-500/10 border border-yellow-500/20 rounded-lg">
      <h2 class="text-xl font-semibold mb-2 text-yellow-400">⚠️ Notas importantes</h2>
      <ul class="list-disc list-inside space-y-1 text-sm">
        <li>Usa <code class="bg-black/20 px-2 py-0.5 rounded">client:only="react"</code> para componentes que solo funcionan en el cliente</li>
        <li>Usa <code class="bg-black/20 px-2 py-0.5 rounded">client:load</code> para componentes que necesitan SSR + hidratación</li>
        <li>Todos los componentes Ant Design deben estar dentro de <code class="bg-black/20 px-2 py-0.5 rounded">&lt;AntdProvider&gt;</code></li>
        <li>Los componentes React (.tsx) no pueden importar componentes Astro (.astro)</li>
      </ul>
    </div>

    <div class="mt-8">
      <a 
        href={withBase('/')} 
        class="inline-block px-6 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition-colors"
      >
        ← Volver al Dashboard
      </a>
    </div>
  </div>
</Layout>
