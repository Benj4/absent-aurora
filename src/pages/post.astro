---
import Layout from '../layouts/Layout.astro';
import AntdProvider from '../components/AntdProvider';
import PostDetail from '../components/PostDetail';
---

<Layout title="Detalle de Publicación">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-6">
      <a href="/" class="text-sm opacity-70 hover:opacity-100">&larr; Volver al Dashboard</a>
    </div>

    <AntdProvider client:load>
      <PostDetail client:only />
    </AntdProvider>
  </div>
</Layout>
