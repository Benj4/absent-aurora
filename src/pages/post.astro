---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="prose max-w-6xl mx-auto" style="padding:1.25rem">
    <div class="mb-6">
      <a href="/" class="text-blue-600 hover:text-blue-800 text-sm">&larr; Back to Dashboard</a>
    </div>

    <h1 id="page-title">Post Details</h1>

    <div id="post-section"></div>

    <script>
      import { supabase } from '../lib/supabase';

      const postSection = document.getElementById('post-section') || document.createElement('div');
      let currentPost: any = null;
      let currentUser: any = null;
      
      async function render() {
        if (!postSection) return;

        // Get the id query parameter
        const urlParams = new URLSearchParams(window.location.search);
        const postId = urlParams.get('id');

        if (!postId) {
          postSection.innerHTML = `
            <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded mb-4">
              <p class="m-0">No post ID provided in URL.</p>
            </div>
          `;
          return;
        }

        // Show loading state
        postSection.innerHTML = '<p>Loading post...</p>';

        // Get current user
        const { data: { user }, error: userError } = await supabase.auth.getUser();
        if (userError) console.error('Auth error:', userError);
        currentUser = user;

        // Fetch the specific post
        const { data: post, error } = await supabase
          .from('serie_posts')
          .select(`
            id, indicator_id, data_source, frequency, status, created_at, updated_at, submitted_by,
            serie_data(id, date, value)
          `)
          .eq('id', postId)
          .single();

        currentPost = post;

        if (error) {
          postSection.innerHTML = `
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
              Error loading post: ${error.message}
            </div>
          `;
          console.error(error);
          return;
        }

        if (!post) {
          postSection.innerHTML = `
            <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded mb-4">
              Post not found.
            </div>
          `;
          return;
        }

        // Render the post card
        const statusColors = {
          'approved': 'bg-green-200 text-green-800',
          'pending': 'bg-yellow-200 text-yellow-800',
          'rejected': 'bg-red-200 text-red-800'
        };

        const statusClass = statusColors[post.status as keyof typeof statusColors] || 'bg-gray-200 text-gray-800';

        let serieDataHtml = '';
        if (post.serie_data && post.serie_data.length > 0) {
          const sortedData = [...post.serie_data].sort((a, b) => 
            new Date(b.date).getTime() - new Date(a.date).getTime()
          );

          serieDataHtml = `
            <div class="mt-4">
              <h3 class="text-lg font-semibold mb-2">Series Data (${post.serie_data.length} points)</h3>
              <div class="overflow-x-auto">
                <table class="min-w-full border border-gray-300">
                  <thead class="bg-gray-100 dark:bg-gray-700">
                    <tr>
                      <th class="border border-gray-300 px-4 py-2 text-left">Date</th>
                      <th class="border border-gray-300 px-4 py-2 text-right">Value</th>
                    </tr>
                  </thead>
                  <tbody>
                    ${sortedData.map(data => `
                      <tr>
                        <td class="border border-gray-300 px-4 py-2">${data.date}</td>
                        <td class="border border-gray-300 px-4 py-2 text-right">${data.value}</td>
                      </tr>
                    `).join('')}
                  </tbody>
                </table>
              </div>
            </div>
          `;
        } else {
          serieDataHtml = `
            <div class="bg-gray-100 dark:bg-gray-700 rounded p-3 mt-3">
              <p class="text-gray-600 m-0">No series data attached to this post.</p>
            </div>
          `;
        }

        postSection.innerHTML = `
          <div class="border border-foreground/20 rounded-lg p-4 bg-foreground/5">
            <div class="flex justify-between items-start mb-3">
              <h2 class="text-xl font-bold mb-0">Post #${post.id}</h2>
              <span class="px-3 py-1 rounded-full text-sm font-semibold ${statusClass}">
                ${post.status}
              </span>
            </div>
            
            <div class="grid grid-cols-2 gap-3 text-sm mb-4">
              <div><strong>Indicator:</strong> ${post.indicator_id}</div>
              <div><strong>Frequency:</strong> ${post.frequency}</div>
              <div><strong>Data Source:</strong> ${post.data_source || 'N/A'}</div>
              <div><strong>Created:</strong> ${new Date(post.created_at).toLocaleDateString()} at ${new Date(post.created_at).toLocaleTimeString()}</div>
              ${post.updated_at ? `<div class="col-span-2"><strong>Updated:</strong> ${new Date(post.updated_at).toLocaleDateString()} at ${new Date(post.updated_at).toLocaleTimeString()}</div>` : ''}
            </div>
            
            ${serieDataHtml}
          </div>
        `;

        // Show validation form if post is pending and user is authenticated
        if (currentUser && post.status === 'pending') {
          // Check if user already validated this post
          const { data: existingValidation } = await supabase
            .from('serie_validations')
            .select('id, validation_status')
            .eq('post_id', post.id)
            .eq('validated_by', currentUser.id)
            .single();

          if (existingValidation) {
            postSection.innerHTML += `
              <div class="mt-6 bg-blue-50 border border-blue-200 text-blue-800 px-4 py-3 rounded">
                <p class="m-0"><strong>You already validated this post as:</strong> ${existingValidation.validation_status}</p>
              </div>
            `;
          } else {
            renderValidationForm();
          }
        } else if (!currentUser && post.status === 'pending') {
          postSection.innerHTML += `
            <div class="mt-6 bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded">
              <p class="m-0">Please <a href="/login" class="underline">sign in</a> to validate this post.</p>
            </div>
          `;
        }
      }

      function renderValidationForm() {
        const formHtml = `
          <div class="mt-6 border border-gray-300 rounded-lg p-4 bg-white">
            <h3 class="text-lg font-semibold mb-4">Validate this Post</h3>
            <form id="validation-form">
              <div class="mb-4">
                <label class="block text-sm font-semibold mb-2">Validation Decision</label>
                <div class="flex gap-4">
                  <label class="inline-flex items-center">
                    <input type="radio" name="validation_status" value="approved" required class="mr-2">
                    <span class="text-green-700 font-semibold">Approve</span>
                  </label>
                  <label class="inline-flex items-center">
                    <input type="radio" name="validation_status" value="rejected" required class="mr-2">
                    <span class="text-red-700 font-semibold">Reject</span>
                  </label>
                </div>
              </div>
              
              <div class="mb-4">
                <label for="validation_notes" class="block text-sm font-semibold mb-2">
                  Notes (Optional)
                </label>
                <textarea 
                  id="validation_notes" 
                  name="validation_notes" 
                  rows="3"
                  class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
                  placeholder="Add any comments or observations about this data..."
                ></textarea>
              </div>
              
              <div class="flex gap-3">
                <button 
                  type="submit" 
                  class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded"
                >
                  Submit Validation
                </button>
                <div id="validation-status" class="flex items-center"></div>
              </div>
            </form>
          </div>
        `;
        
        postSection.innerHTML += formHtml;

        // Attach form submit handler
        const form = document.getElementById('validation-form') as HTMLFormElement;
        const statusDiv = document.getElementById('validation-status') || document.createElement('div');
        
        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          if (!currentUser || !currentPost) return;
          
          statusDiv.innerHTML = '<span class="text-gray-600">Submitting...</span>';
          
          const formData = new FormData(form);
          const validationStatus = formData.get('validation_status');
          const validationNotes = formData.get('validation_notes');
          
          const { error } = await supabase
            .from('serie_validations')
            .insert({
              post_id: currentPost.id,
              validated_by: currentUser.id,
              validation_status: validationStatus,
              validation_notes: validationNotes || null
            });
          
          if (error) {
            statusDiv.innerHTML = `<span class="text-red-600">Error: ${error.message}</span>`;
            console.error(error);
            return;
          }
          
          statusDiv.innerHTML = '<span class="text-green-600">✓ Validation submitted successfully!</span>';
          
          // Reload after a short delay
          setTimeout(() => {
            render();
          }, 1500);
        });
      }

      // Initial render
      render();
    </script>
  </main>
</Layout>
