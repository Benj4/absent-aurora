---
import "../styles/global.css";
import Navbar from "../components/Navbar.tsx";
import Breadcrumbs from "../components/Breadcrumbs.tsx";
import AuthSessionBootstrap from "../components/AuthSessionBootstrap.tsx";
import { withBase } from '../lib/paths';

interface Props {
	title?: string;
	breadcrumbItems?: { label: string; href?: string }[];
}

const {
	title = 'Mites Absent Aurora',
	breadcrumbItems = [],
} = Astro.props;

---

<!doctype html>
<html lang="es" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			try {
				document.documentElement.dataset.theme =
					localStorage.getItem('absent-aurora-theme') === 'dark' ? 'dark' : 'light';
			} catch {
				// Keep the default light theme when storage is unavailable.
			}
		</script>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="min-h-screen flex flex-col bg-base-100 text-base-content">
			<AuthSessionBootstrap client:load />
			<Navbar client:load />
			<Breadcrumbs items={breadcrumbItems} client:load />
			<main class="flex-1">
				<slot />
			</main>
		</div>
	</body>
</html>
