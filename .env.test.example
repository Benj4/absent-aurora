# Supabase Test Configuration
# Copy this file to .env.test and use an isolated test project only.

# Explicit safety switch required by tests/setup.ts
ALLOW_SUPABASE_INTEGRATION_TESTS=false

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Required for remote projects. Must match the subdomain in SUPABASE_URL.
SUPABASE_TEST_PROJECT_REF=your-project

# Service role key (required for testing - bypasses RLS for setup)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anon key for client-side testing
SUPABASE_ANON_KEY=your-anon-key-here

# Test user credentials
TEST_USER_1_EMAIL=testuser1@example.com
TEST_USER_1_PASSWORD=testpassword123

TEST_USER_2_EMAIL=testuser2@example.com
TEST_USER_2_PASSWORD=testpassword123
